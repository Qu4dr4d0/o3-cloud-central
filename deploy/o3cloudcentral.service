[Unit]
Description=O3 Cloud Central
After=network-online.target mariadb.service
Wants=network-online.target
Requires=mariadb.service

[Service]
User=_o3cloudcentral
Group=_o3cloudcentral
WorkingDirectory=/var/lib/o3cloudcentral
EnvironmentFile=/etc/o3cloudcentral.env
ExecStart=/opt/o3cloudcentral/venv/bin/python -B -m o3cloudcentral central --dir /var/lib/o3cloudcentral --listen :8443 --internal-only=false
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/o3cloudcentral
UMask=0077

[Install]
WantedBy=multi-user.target
